# ae controller environment (systemd EnvironmentFile)

# Runtime backend: podman (default) or docker
#AE_RUNTIME_BACKEND=podman

# Podman shared network for multi-replica + ingress DNS (recommended)
#AE_PODMAN_NETWORK=devnet

# Ingress (Caddy) integration
#AE_CADDY_SITES=/etc/caddy/dynsites
#AE_CADDY_FILE=/etc/caddy/Caddyfile
#AE_CADDY_CONTAINER=dev-caddy-1
#AE_CONTAINER_CLI=podman

# Controller specs/state
#AE_SPECS_DIR=/etc/ae/specs
#AE_STATE_DB=/var/lib/ae/controller.db
#AE_METRICS_PORT=9108
#AE_WATCH=1

# Probe/backoff tuning (optional)
#AE_PROBE_MAX_BACKOFF=30
#AE_RESTART_WINDOW_SEC=60
#AE_RESTART_THRESHOLD=3
#AE_RECREATE_COOLDOWN_SEC=30

# Docs service (optional)
#AE_DOCS_DIR=/usr/share/ae/docs
#AE_DOCS_PORT=9109

# Harden systemd units on install (creates drop-ins with stricter defaults)
#AE_SYSTEMD_HARDEN=1
