[Unit]
Description=AE Controller (k1s minimal application engine)
After=network.target

[Service]
Type=simple
Environment=AE_STATE_DB=/var/lib/ae/controller.db
Environment=AE_SPECS_DIR=/etc/ae/specs
ExecStart=/usr/bin/python -m ae.controller --loop --specs ${AE_SPECS_DIR} --metrics-port 9108 --watch
WorkingDirectory=/var/lib/ae
Restart=on-failure
RestartSec=3
User=ae
Group=ae

[Install]
WantedBy=multi-user.target
