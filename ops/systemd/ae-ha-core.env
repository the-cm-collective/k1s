# ae HA core environment (systemd EnvironmentFile)

# Absolute path to the active k1s checkout used by ae-ha-core-service.
AE_REPO_ROOT=__REPO_ROOT__

# Required HA identity and shared dependencies
#AE_CONTROLLER_ID=core-a
#AE_CONTROLLER_ADVERTISE_ADDR=https://core-a.example.net:9108
#AE_ETCD_ENDPOINTS=http://10.0.0.11:2379,http://10.0.0.12:2379,http://10.0.0.13:2379
#AE_ETCD_PREFIX=/k1s/prod
#AE_NATS_URL=nats://10.0.0.21:4222,nats://10.0.0.22:4222,nats://10.0.0.23:4222

# HA k1s-core defaults
#AE_HA_MODE=1
#AE_STATE_BACKEND=etcd
#AE_TRANSPORT_BACKEND=nats-js
#AE_RUNTIME_BACKEND=cri
#AE_INFRA_BACKEND=cri
#AE_APISHIM_MODE=cri
#AE_JS_DOMAIN=K1S
#AE_ETCD_MAINTENANCE_ENABLE=0

# Optional HA core-node settings
#AE_METRICS_PORT=9108
#APISHIM_PORT=8445
#EDGE_INGRESS_MODE=core-proxy
#EDGE_INGRESS_START=1
#AE_DEV_LOCAL=0
#AE_LABS=0
#CORE_CADDY=0
#CORE_DOCS=0
