[Unit]
Description=AE HA Core Node (k1s-ha-core)
After=network.target network-online.target containerd.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=__ENV_FILE__
ExecStart=__WRAPPER__
WorkingDirectory=/var/lib/ae
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
