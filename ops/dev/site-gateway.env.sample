# Site Gateway (future) sample config
# Ack policy defaults (Option A: durable local commit before AckSync).

# NATS credentials (JWT/operator mode). Use alongside AE_NATS_URL.
# AE_NATS_CREDS=/etc/nats/creds/gateway.creds

# Failover/redelivery target. Progress acks extend by this interval.
AE_GATEWAY_JS_ACK_WAIT=30s

# Progress acks per inflight message (≈ ack_wait / 3).
AE_GATEWAY_JS_ACK_PROGRESS_INTERVAL=10s

# Jitter percent on progress timer to avoid synchronized bursts.
AE_GATEWAY_JS_ACK_PROGRESS_JITTER_PCT=15

# Require fresh worker heartbeats to keep AckProgress flowing.
# Default is max(2*progress_interval, 0.8*ack_wait) when unset.
AE_GATEWAY_WORK_HEARTBEAT_TIMEOUT=24s

# Delay before NAK redelivery when heartbeat is stale.
AE_GATEWAY_WORK_NAK_DELAY=2s

# Bound in-flight messages to the gateway's concurrency budget.
AE_GATEWAY_JS_MAX_ACK_PENDING=32

# Bounded redelivery attempts for visibility.
AE_GATEWAY_JS_MAX_DELIVER=20

# Cap pull consumer waiters to avoid memory blowups.
AE_GATEWAY_JS_MAX_WAITING=512

# Local durable spool (sqlite or append-log).
AE_GATEWAY_SPOOL_PATH=/var/lib/ae/gateway/spool.db

# JetStream domain (when configured on hub).
AE_JS_DOMAIN=K1S
