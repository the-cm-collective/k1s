docs.home.arpa:443, docs.home.arpa
{
    tls internal
    encode gzip zstd

    @static {
        path *
        not path /swagger* /redoc* /dashboard* /openapi* /health* /status* /events* /logs* /metrics* /labs* /system* /ui/features /api/apishim/* /api/v1 /api/v1/* /apis /apis/*
    }
    handle @static {
        root * /srv/docs
        file_server browse
    }

    # Proxy API endpoints to the controller on the host
    @api {
        path /swagger* /redoc* /openapi* /health* /status* /events* /logs* /metrics* /labs* /system* /ui/features /api/apishim/*
    }
    handle @api {
        reverse_proxy {
            to host.docker.internal:9108
            header_up Host {http.reverse_proxy.upstream.hostport}
        }
    }

    # Proxy shim API (exec/port-forward) to the apishim service
    @apishim {
        path /api/v1 /api/v1/* /apis /apis/*
    }
    handle @apishim {
        reverse_proxy https://{$APISHIM_UPSTREAM:apishim:8445} {
            transport http {
                tls_insecure_skip_verify
            }
        }
    }
}
