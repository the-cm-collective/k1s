# Host A GPU guest local machine profile
#
# Copy this file to state/host-a-gpu.env and fill in values for your workstation:
#
#   cp ops/dev/host-a-gpu.env.sample state/host-a-gpu.env
#
# The local state file is gitignored. The helper auto-loads state/host-a-gpu.env when
# it exists. Override with --env-file or HOST_A_GPU_ENV_FILE when needed.

# Required hardware selectors.
# Provide either the interface name or the PCI address for the dedicated passthrough NIC.
HOST_A_GPU_PRIMARY_NIC_NAME=enp0s31f6
# HOST_A_GPU_PRIMARY_NIC_PCI=0000:00:1f.6
HOST_A_GPU_GPU_PCI=0000:40:00.0
HOST_A_GPU_GPU_AUDIO_PCI=0000:40:00.1

# Optional hardware assertions and overrides.
# HOST_A_GPU_PRIMARY_NIC_MAC=10:20:30:40:50:60
# HOST_A_GPU_EXPECTED_PRIMARY_IOMMU_GROUP=15

# Optional local path overrides.
# HOST_A_GPU_BASE_IMAGE=artifacts/images/ubuntu-22.04-k1s-gpu.qcow2
# HOST_A_GPU_OVERLAY_DIR=~/VMs
# HOST_A_GPU_STATE_ROOT=state/libvirt-host-a
# HOST_A_GPU_SSH_PUBLIC_KEY_FILE=~/.ssh/id_ed25519.pub
# HOST_A_GPU_OVMF_CODE=/run/libvirt/nix-ovmf/OVMF_CODE.fd
# HOST_A_GPU_OVMF_VARS_TEMPLATE=/run/libvirt/nix-ovmf/OVMF_VARS.fd

# Optional libvirt and guest-shape overrides.
# HOST_A_GPU_CONNECTION_URI=qemu:///system
# HOST_A_GPU_DOMAIN_NAME=k1s-core-a-gpu
# HOST_A_GPU_GUEST_HOSTNAME=k1s-core-a-gpu
# HOST_A_GPU_NODE_ID=core-a--hub
# HOST_A_GPU_GUEST_USER=ae
# HOST_A_GPU_GUEST_REPO=/mnt/host
# HOST_A_GPU_MACHINE=pc-q35-5.1
# HOST_A_GPU_MEMORY_MIB=16384
# HOST_A_GPU_HARD_LIMIT_MIB=18432
# HOST_A_GPU_VCPUS=8
# HOST_A_GPU_CPU_SOCKETS=1
# HOST_A_GPU_CPU_CORES=4
# HOST_A_GPU_CPU_THREADS=2
# HOST_A_GPU_IOTHREADS=1
# HOST_A_GPU_HUGEPAGES_KIB=2048
# HOST_A_GPU_OVERLAY_SIZE_GIB=80
# HOST_A_GPU_MGMT_NETWORK=default
