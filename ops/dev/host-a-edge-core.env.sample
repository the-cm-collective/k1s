# Render this file from a live Host B release with:
#   python scripts/dev/microk8s_stack_bundle.py \
#     --release k1s-dev-a \
#     --namespace k1s-dev-a \
#     --site-id host-a \
#     --from-kube \
#     --format env \
#     --output .local/host-a-edge-core.env
#
# Preferred topology: use this env in a tiny dedicated Host A edge-core VM.
# Fallback topology: source the same env inside the existing GPU VM and start
# the edge-core role there under separate systemd units and cgroup limits.

EDGE_PROFILE=k1s-ha-core
EDGE_INGRESS_MODE=core-proxy
AE_RUNTIME_BACKEND=cri
AE_INFRA_BACKEND=cri
AE_SITE_ID=host-a
AE_CONTROLLER_URL=http://192.168.29.15:9110
AE_AGENT_TOKEN=replace-me
AE_NATS_HUB_LEAF_HOST=192.168.29.15
AE_NATS_HUB_LEAF_PORT=7422
AE_RATHOLE_SERVER_ADDR=192.168.29.15:2333
AE_RATHOLE_DEFAULT_TOKEN=replace-me
AE_REGISTRY_HOST=registry.k1s.home.arpa:32000
K1S_STACK_DOMAIN=k1s-dev-a.home.arpa
K1S_WILDCARD_APPS_DOMAIN=*.apps.k1s-dev-a.home.arpa
K1S_NATS_LEAF_ADDR=192.168.29.15:7422
K1S_NATS_LEAF_URL=nats://site-uplink:replace-me@192.168.29.15:7422
